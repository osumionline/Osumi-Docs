{
  "name": "osumionline/docs",
  "description": "Documentación oficial para Osumi Framework.",
  "type": "project",
  "keywords": ["osumi", "framework", "docs"],
  "homepage": "https://framework.osumi.dev",
  "license": "MIT",
  "authors": [
    {
      "name": "Iñigo Gorosabel",
      "homepage": "https://osumi.es",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.5",
    "league/commonmark": "^2.8",
    "osumionline/framework": "^9.12.1"
  },
  "autoload": {
    "psr-4": {
      "Osumi\\OsumiFramework\\App\\": "src/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "osumionline/plugin-updater": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
